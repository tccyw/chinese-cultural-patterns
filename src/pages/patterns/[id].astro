---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { patterns, sourceLegend } from "@/data/patterns";

export function getStaticPaths() {
  return patterns.map((pattern) => ({
    params: { id: pattern.id },
    props: { pattern }
  }));
}

const { pattern } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={pattern.title} description={pattern.summary}>
  <section class="page-shell">
    <div class="detail-hero">
      <div>
        <div class="chips">
          <span class="chip">{pattern.category}</span>
          <span class="chip">{pattern.earliestEra}</span>
        </div>
        <h1>{pattern.title}</h1>
        <p>{pattern.summary}</p>
        <div class="chips">
          {pattern.aliases.map((alias) => <span class="chip">{alias}</span>)}
        </div>
      </div>
      <figure class="detail-figure">
        <img src={`${base}${pattern.variants[0].svgAsset.slice(1)}`} alt={`${pattern.title}原创重构图`} />
      </figure>
    </div>

    <div class="content-grid">
      <div>
        <section class="section">
          <h2>历史谱系</h2>
          <p>{pattern.history}</p>
        </section>

        <section class="section">
          <h2>时代线索</h2>
          <div class="timeline">
            {pattern.activeEras.map((era) => (
              <div class="timeline-item">
                <strong>{era}</strong>
                <span>与该图样的形成、流行、转化或复兴相关。</span>
              </div>
            ))}
          </div>
        </section>

        <section class="section">
          <h2>典型器物与资料线索</h2>
          <ul>
            {pattern.artifacts.map((artifact) => (
              <li>
                <strong>{artifact.title}</strong>（{artifact.era}）
                {artifact.institution ? `，${artifact.institution}` : ""}。
                {artifact.sourceUrl ? <a href={artifact.sourceUrl}>来源</a> : null}
                <br />{artifact.note}
              </li>
            ))}
          </ul>
        </section>
      </div>

      <aside>
        <section class="section">
          <h2>载体</h2>
          <div class="chips">
            {pattern.carriers.map((carrier) => <span class="chip">{carrier}</span>)}
          </div>
        </section>
        <section class="section">
          <h2>地域</h2>
          <div class="chips">
            {pattern.regions.map((region) => <span class="chip">{region}</span>)}
          </div>
        </section>
        <section class="section">
          <h2>参考资料</h2>
          <div class="reference-list">
            {pattern.references.map((reference) => (
              <div class="reference">
                <span class="confidence">{reference.confidence}</span>
                {reference.url ? <a href={reference.url}>{reference.title}</a> : <span>{reference.title}</span>}
                <p>{sourceLegend[reference.confidence]}</p>
              </div>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </section>
</BaseLayout>
